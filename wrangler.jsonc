{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buchonean2-marketing",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  }
}
