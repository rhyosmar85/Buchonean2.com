{
  "name": "buchonean2-marketing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "preview:cloudflare": "wrangler dev --ip 127.0.0.1 --port 8787",
    "test": "node --test tests/seo.test.mjs",
    "test:browser": "playwright test",
    "test:performance": "node scripts/performance.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets": "node scripts/prepare-assets.mjs",
    "prebuild": "npm run assets",
    "predev": "npm run assets"
  },
  "dependencies": {
    "i18next": "^25.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@fontsource-variable/archivo": "^5.3.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "cheerio": "^1.1.2",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "wrangler": "^4.45.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
